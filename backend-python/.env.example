# Same Supabase project the TypeScript backend already uses -- this port
# does NOT migrate the database, only the application layer that talks to
# it. Copy this file to .env and fill in the real values from the current
# deployment's environment variables (Lovable/Cloudflare Worker secrets).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=

GEMINI_API_KEY=
OPENAI_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_HR_BOT_TOKEN=

VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

CRON_SECRET=
